# Nothing here is generated: the packages have no dependencies and the MCP server
# needs none. Only run artifacts and editor noise are ignored.
node_modules/
.DS_Store
*.log

# The live suite's scratch patterns stay visible to git on purpose. A worker now
# writes into a disposable copy and what reaches this tree is a patch computed with
# `git diff`, so an ignored probe name is a probe the verification cannot see — the
# suite's own cleanup, not .gitignore, is what keeps a run from leaving a trace.
#
# Only the guard scratch directory is ignored: the wall stages deliberately create
# and delete it inside a throwaway decoy root.
.env.flash-guard-*
flash-guard-scratch-*/
