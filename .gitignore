# Nothing here is generated: the packages have no dependencies and the MCP server
# needs none. Only run artifacts and editor noise are ignored.
node_modules/
.DS_Store
*.log

# Artifacts the live suite leaves behind if it is interrupted mid-stage. It
# cleans up after itself; these patterns only exist so an interrupted run cannot
# dirty a commit.
flash-mcp-probe.txt
flash-fleet-*.txt
flash-readonly-probe-*.txt
.env.flash-guard-*
flash-guard-scratch-*/
